{
  "$schema": "https://json.schemastore.org/claude-code-settings.json",
  "model": "claude-opus-4-7",
  "permissions": {
    "defaultMode": "acceptEdits",
    "allow": [
      "Bash(uv:*)",
      "Bash(git:*)",
      "Bash(grep:*)",
      "Bash(tail:*)",
      "Bash(head:*)",
      "Bash(wc:*)",
      "Bash(ls:*)",
      "Bash(cat results.tsv)",
      "Bash(cat run.log)",
      "Bash(rm run.log)",
      "Bash(mkdir:*)",
      "Bash(nvidia-smi:*)",
      "Bash(test:*)",
      "Bash(python -c:*)",
      "Read",
      "Edit(train.py)",
      "Edit(results.tsv)",
      "Write(results.tsv)",
      "Write(run.log)"
    ],
    "deny": [
      "Edit(prepare.py)",
      "Edit(pyproject.toml)",
      "Edit(uv.lock)",
      "Edit(.claude/**)",
      "Edit(CLAUDE.md)",
      "Edit(program.md)",
      "Bash(uv add:*)",
      "Bash(uv remove:*)",
      "Bash(pip install:*)",
      "Bash(pip uninstall:*)",
      "Bash(git push:*)",
      "Bash(git push --force:*)",
      "Bash(rm -rf:*)",
      "Bash(rm -r:*)",
      "Bash(sudo:*)"
    ]
  },
  "hooks": {
    "Stop": [
      {
        "matcher": "*",
        "hooks": [
          {
            "type": "command",
            "command": "$CLAUDE_PROJECT_DIR/.claude/hooks/continue-loop.sh"
          }
        ]
      }
    ]
  }
}
